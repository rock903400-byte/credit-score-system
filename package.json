{
  "name": "credit-score-system",
  "version": "2.0.0",
  "private": true,
  "description": "信用評分與核貸試算系統 — 儲蓄互助社授信試算工具",
  "scripts": {
    "test": "node test.js",
    "test:e2e": "playwright test",
    "test:all": "node test.js && playwright test",
    "serve": "node serve.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "simulate:1k": "node simulate_1000.js",
    "simulate:10k": "node simulate_10000.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
